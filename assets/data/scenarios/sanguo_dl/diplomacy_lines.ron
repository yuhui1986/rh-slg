// 外交台词定义
// 每个势力在不同外交情境下的台词

{
    "faction_wei": {
        "alliance": [
            "尔等若肯归附，孤必厚待。",
            "天下大势，合久必分，分久必合。今日联手，共图大业。",
            "识时务者为俊杰，将军深明大义。",
        ],
        "declare_war": [
            "孤率百万之师，踏平尔等弹丸之地。",
            "不识时务，自取灭亡。",
            "天命在孤，顺我者昌，逆我者亡。",
        ],
        "peace_offer": [
            "今日暂且休兵，来日再决雌雄。",
            "孤念尔等尚有可取之处，特赐和约。",
        ],
        "demand_surrender": [
            "尔等已是瓮中之鳖，何不早降？",
            "孤大军压境，识趣者当知进退。",
        ],
        "trade": [
            "互通有无，各取所需。",
            "商场如战场，但求公平交易。",
        ],
    },
    "faction_shu": {
        "alliance": [
            "汉贼不两立，王业不偏安。愿与将军共讨国贼。",
            "兴复汉室，还于旧都。将军可愿同行？",
            "兄弟同心，其利断金。",
        ],
        "declare_war": [
            "汉室正统在此，尔等还不束手就擒？",
            "匡扶汉室，讨伐不臣。",
            "先帝创业未半，中道崩殂。今当北定中原。",
        ],
        "peace_offer": [
            "暂息干戈，以待天时。",
            "非战之罪，实乃天命未至。",
        ],
        "demand_surrender": [
            "尔等若肯归汉，不失封侯之位。",
            "天命在汉，何苦逆天而行？",
        ],
        "trade": [
            "蜀锦天下闻名，愿与将军互通有无。",
            "互利共赢，方为长久之计。",
        ],
    },
    "faction_wu": {
        "alliance": [
            "江东六郡，地广人稠。愿与将军共分天下。",
            "联刘抗曹，乃江东国策。",
            "唇亡齿寒，将军不可不察。",
        ],
        "declare_war": [
            "江东子弟，岂惧一战？",
            "尔等犯我疆界，莫怪刀剑无眼。",
            "长江天险，尔等休想跨越半步。",
        ],
        "peace_offer": [
            "和为贵，战为下。愿将军三思。",
            "暂且休兵，各守疆界。",
        ],
        "demand_surrender": [
            "江东水军天下无敌，尔等何苦以卵击石？",
            "识时务者为俊杰，将军何不归顺？",
        ],
        "trade": [
            "江东物产丰富，愿与将军互通商贸。",
            "鱼盐之利，足以富国。愿共享之。",
        ],
    },
    "faction_liaodong": {
        "alliance": [
            "辽东苦寒之地，愿与将军互为犄角。",
            "远交近攻，方为上策。",
        ],
        "declare_war": [
            "辽东铁骑，踏遍中原。",
            "尔等欺人太甚，莫怪我翻脸无情。",
        ],
        "peace_offer": [
            "各自休养生息，来日再议。",
            "和则两利，战则两伤。",
        ],
        "demand_surrender": [
            "辽东虽远，铁骑可至。将军三思。",
        ],
        "trade": [
            "辽东马匹天下闻名，愿与将军交易。",
        ],
    },
    "faction_nanzhong": {
        "alliance": [
            "南中勇士，愿助将军一臂之力。",
            "结盟共进，各取所需。",
        ],
        "declare_war": [
            "南蛮勇士，不惧中原大军。",
            "犯我南中者，虽远必诛。",
        ],
        "peace_offer": [
            "罢兵言和，各安其土。",
            "南中不求争霸，但求安宁。",
        ],
        "demand_surrender": [
            "南中勇士善战，尔等何苦自寻死路？",
        ],
        "trade": [
            "南中象兵、藤甲，天下奇物。愿与将军交易。",
        ],
    },
