// 三国鼎立剧本区域规则定义
// 对应 Rust 类型: Vec<ZoneRule> (见 crates/slg-core/src/rule/zone_rule.rs)
// ZoneRule 字段: zone_id (String), tiles (BTreeSet<TileKey>), effects (Vec<ZoneEffect>), active (bool)
// TileKey = u64, 由 (q, r) 编码: ((r << 32) | q)
// 注: ZoneRule 结构体不含 name 字段，区域名称以注释形式标注。

[
    // ---- 洛阳: 资源丰富，防御加成高 ----
    (
        zone_id: "zone_luoyang",
        tiles: [
            // (127, 79) (128, 79) (129, 79)
            // (127, 80) (128, 80) (129, 80)
            // (127, 81) (128, 81) (129, 81)
            339302416511, 339302416512, 339302416513,
            343597383807, 343597383808, 343597383809,
            347892351103, 347892351104, 347892351105,
        ],
        effects: [
            (ResourceMultiplier: { resource: "gold", factor: 2.0 }),
            (ResourceMultiplier: { resource: "food", factor: 1.5 }),
            (DefenseBonus: { factor: 0.5 }),
        ],
        active: true,
    ),

    // ---- 蜀道: 移动代价高，有防御加成 ----
